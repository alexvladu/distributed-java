# Development defaults. run.sh copies this file to .env on first start; .env is ignored by git.
# Change every password before exposing any port beyond localhost. Values with special characters
# are single-quoted so both bash and Docker Compose read them literally.

POSTGRES_DB=stock_market
POSTGRES_USER=stock_app
POSTGRES_PASSWORD='stock_app_password'
POSTGRES_PORT=5432
POSTGRES_URL='jdbc:postgresql://localhost:5432/stock_market'

# sa is used only by database-migrations, which provisions the SQLSERVER_USER login for the application.
MSSQL_SA_PASSWORD='StockMarket_SA_123!'
MSSQL_PORT=1433
SQLSERVER_URL='jdbc:sqlserver://localhost:1433;databaseName=stock_market;encrypt=false'
SQLSERVER_USER=stock_app
SQLSERVER_PASSWORD='StockMarket_App_123!'

ORACLE_PASSWORD='StockMarket_Oracle_123!'
ORACLE_APP_USER=stock_app
ORACLE_APP_PASSWORD='stock_app_password'
ORACLE_PORT=1521
ORACLE_URL='jdbc:oracle:thin:@localhost:1521/FREEPDB1'

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=stock-prices

# Optional: directory holding tomcat-base and jetty-base (default: <repository>/servere).
# SERVERS_DIR=/path/to/servere
